# Optional URL override for the main Flask API (default shown).
MEDICINAL_VIT_PREDICT_URL=http://127.0.0.1:5001/medicinal/predict

# Optional Vite API URL overrides (same-origin defaults shown).
VITE_PREDICT_URL=/predict
